# Copy to .env (git-ignored). Never commit real values.
GEMINI_API_KEY=            # reviewers: Google AI Studio key
GOOGLE_CLOUD_PROJECT=      # dev only: Vertex project (uses gcloud auth)
LLM_PROVIDER=vertex        # vertex | gemini_api
LLM_MODEL=gemini-2.5-flash
TELEGRAM_BOT_TOKEN=        # fresh bot from BotFather
TELEGRAM_CHAT_ID=
CP_SIGNING_KEY=            # random 32+ bytes for HMAC tokens
DATA_SOURCE=local_folder   # local_folder | drive_public
DRIVE_FOLDER_ID=

# Copy to .env (git-ignored). Never commit real values.
GEMINI_API_KEY=   # Google AI Studio key (reviewers); leave empty to use Vertex
GOOGLE_CLOUD_PROJECT=      # dev only: Vertex project (uses gcloud auth)
LLM_PROVIDER=vertex        # vertex | gemini_api
LLM_MODEL=gemini-2.5-flash
TELEGRAM_BOT_TOKEN=   # fresh bot from BotFather
TELEGRAM_CHAT_ID=
CP_SIGNING_KEY=   # REQUIRED, >=32 bytes random: python -c "import secrets;print(secrets.token_urlsafe(48))"
DATA_SOURCE=local_folder   # local_folder | drive_public
DRIVE_FOLDER_ID=
CP_WORKER_TOKEN=   # REQUIRED, random: python -c "import secrets;print(secrets.token_urlsafe(32))"

{
  "$defs": {
    "ApprovalState": {
      "additionalProperties": false,
      "description": "Only a capability digest and consumption timestamp enter checkpoints.",
      "properties": {
        "token_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Token Hash",
          "type": "string"
        },
        "used_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Used At"
        }
      },
      "required": [
        "token_hash"
      ],
      "title": "ApprovalState",
      "type": "object"
    },
    "FieldResult": {
      "additionalProperties": false,
      "description": "Read-back comparison, including a visible escalation reason.",
      "properties": {
        "actual": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "escalated": {
          "default": false,
          "title": "Escalated",
          "type": "boolean"
        },
        "field_key": {
          "minLength": 1,
          "title": "Field Key",
          "type": "string"
        },
        "generated": {
          "default": false,
          "title": "Generated",
          "type": "boolean"
        },
        "intended": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "matched": {
          "default": false,
          "title": "Matched",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "field_key"
      ],
      "title": "FieldResult",
      "type": "object"
    },
    "FieldSpec": {
      "additionalProperties": false,
      "description": "One extracted control with an extractor-assigned stable key.",
      "properties": {
        "current_value": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "group": {
          "default": "",
          "title": "Group",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "key",
        "label",
        "type"
      ],
      "title": "FieldSpec",
      "type": "object"
    },
    "FillAction": {
      "additionalProperties": false,
      "description": "Planner proposal; policy must authorize it before execution.",
      "properties": {
        "action": {
          "enum": [
            "fill",
            "select",
            "check",
            "upload_resume",
            "ask_user",
            "skip"
          ],
          "title": "Action",
          "type": "string"
        },
        "field_key": {
          "minLength": 1,
          "title": "Field Key",
          "type": "string"
        },
        "generated": {
          "default": false,
          "title": "Generated",
          "type": "boolean"
        },
        "question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "value": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        }
      },
      "required": [
        "field_key",
        "action"
      ],
      "title": "FillAction",
      "type": "object"
    },
    "FillReport": {
      "additionalProperties": false,
      "description": "Verification result; unresolved fields cannot be called verified.",
      "properties": {
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/FieldResult"
          },
          "title": "Fields",
          "type": "array"
        }
      },
      "title": "FillReport",
      "type": "object"
    },
    "JobStatus": {
      "description": "AGENT_GRAPH section 4; pause is a separate overlay.",
      "enum": [
        "QUEUED",
        "OPENED",
        "FILLING",
        "NEEDS_HUMAN",
        "NEEDS_ANSWER",
        "READY_FOR_REVIEW",
        "APPROVED",
        "SUBMITTING",
        "SUBMITTED_VERIFIED",
        "SUBMITTED_UNVERIFIED",
        "FAILED",
        "SKIPPED_DUPLICATE",
        "QUARANTINED",
        "NOT_SUPPORTED",
        "REJECTED_BY_USER",
        "APPROVAL_EXPIRED",
        "CANCELLED"
      ],
      "title": "JobStatus",
      "type": "string"
    },
    "JsonValue": {},
    "PageState": {
      "description": "Documented deterministic page classifications.",
      "enum": [
        "FORM",
        "LOGIN",
        "CAPTCHA",
        "CLOSED",
        "UNSUPPORTED",
        "CONFIRMATION",
        "UNKNOWN"
      ],
      "title": "PageState",
      "type": "string"
    },
    "ReviewSnapshot": {
      "additionalProperties": false,
      "description": "Canonical read-back values used to bind human approval.",
      "properties": {
        "fields": {
          "items": {
            "$ref": "#/$defs/FieldResult"
          },
          "title": "Fields",
          "type": "array"
        },
        "generated_texts": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Generated Texts",
          "type": "object"
        },
        "screenshots": {
          "items": {
            "type": "string"
          },
          "title": "Screenshots",
          "type": "array"
        },
        "unanswered": {
          "items": {
            "type": "string"
          },
          "title": "Unanswered",
          "type": "array"
        },
        "uploads": {
          "items": {
            "$ref": "#/$defs/Upload"
          },
          "title": "Uploads",
          "type": "array"
        }
      },
      "title": "ReviewSnapshot",
      "type": "object"
    },
    "Upload": {
      "additionalProperties": false,
      "description": "Reviewed upload identity binds the actual file's content hash.",
      "properties": {
        "field_key": {
          "title": "Field Key",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "field_key",
        "name",
        "sha256"
      ],
      "title": "Upload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "AGENT_GRAPH section 3 plus explicit serializable resume metadata.",
  "properties": {
    "actions": {
      "items": {
        "$ref": "#/$defs/FillAction"
      },
      "title": "Actions",
      "type": "array"
    },
    "approval": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "blockers": {
      "items": {
        "type": "string"
      },
      "title": "Blockers",
      "type": "array"
    },
    "browser_target_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Browser Target Id"
    },
    "evidence": {
      "items": {
        "type": "string"
      },
      "title": "Evidence",
      "type": "array"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/FieldSpec"
      },
      "title": "Fields",
      "type": "array"
    },
    "fill_report": {
      "anyOf": [
        {
          "$ref": "#/$defs/FillReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "page_state": {
      "$ref": "#/$defs/PageState",
      "default": "UNKNOWN"
    },
    "paused": {
      "default": false,
      "title": "Paused",
      "type": "boolean"
    },
    "repair_attempts": {
      "default": 0,
      "maximum": 2,
      "minimum": 0,
      "title": "Repair Attempts",
      "type": "integer"
    },
    "review_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "review_snapshot_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Snapshot Hash"
    },
    "status": {
      "$ref": "#/$defs/JobStatus",
      "default": "QUEUED"
    },
    "url": {
      "title": "Url",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "url"
  ],
  "title": "JobState",
  "type": "object"
}
